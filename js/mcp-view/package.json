  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developmentseed/mcp-toolsets-runtime.git",
    "directory": "js/mcp-view"
  }
